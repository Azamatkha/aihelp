# Telegram bot (long polling).
# O'rnatish: sudo cp deploy/aihelp-bot.service /etc/systemd/system/
# User va yo'llarni serverga moslang (README).
[Unit]
Description=AI Help Telegram bot
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=iccturon
WorkingDirectory=/opt/aihelp
Environment=PYTHONUNBUFFERED=1 PYTHONUTF8=1
ExecStartPre=/opt/aihelp/venv/bin/python manage.py migrate --noinput
ExecStart=/opt/aihelp/venv/bin/python manage.py runbot
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
